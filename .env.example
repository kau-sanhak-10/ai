# 이 파일을 복사해서 .env를 만드세요. 실제 키는 .env에만 넣고 절대 커밋하지 않습니다.

# local | dev | prod (prod에서는 /docs를 닫습니다)
APP_ENV=local

# LLM·Vision·Jev 키 — 쓰는 것만 채우세요. 비워 두면 없는 것으로 처리합니다.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JEV_API_KEY=
# Spring 내부 전용 키 (양쪽에서 동일하게 설정)
INTERNAL_KEY=
# 검증된 직접 API 모델 ID. 미설정 시 AI_MODEL_ERROR를 반환합니다.
OPENAI_MODEL=
