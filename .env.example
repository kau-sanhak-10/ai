# 이 파일을 복사해서 .env를 만드세요. 실제 키는 .env에만 넣고 절대 커밋하지 않습니다.

# local | dev | prod (prod에서는 /docs를 닫습니다)
APP_ENV=local

# LLM·Vision·Jev 키 — 쓰는 것만 채우세요. 비워 두면 없는 것으로 처리합니다.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JEV_API_KEY=
# Spring 내부 전용 키 (양쪽에서 동일하게 설정)
INTERNAL_KEY=
# Dev 실행 역할에서 접근이 확인된 Bedrock 텍스트 모델/추론 프로파일 ID.
# AWS 인증은 실행 역할 또는 로컬 AWS 프로파일을 사용합니다.
BEDROCK_MODEL_ID=
AWS_DEFAULT_REGION=
# 기존 직접 API 실험용. 문의 API에서는 사용하지 않습니다.
OPENAI_MODEL=
# 분석 1회 전체 제한(초). Spring의 30초보다 짧아야 합니다.
INTAKE_TIMEOUT_SECONDS=25
